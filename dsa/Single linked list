import java.util.Scanner;

class Node {
    int data;
    Node next;

    // Constructor
    Node(int data) {
        this.data = data;
        this.next = null;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);

        System.out.print("Enter number of elements: ");
        int x = s.nextInt();

        Node head = null;
        Node tail = null; // FIX: declare tail as Node

        // Input elements
        for (int i = 0; i < x; i++) {
            int element = s.nextInt();  // FIX: nextInt(), not nextint()
            Node newNode = new Node(element);

            if (head == null) {
                head = newNode;
                tail = newNode;
            } else {
                tail.next = newNode;
                tail = newNode;
            }
        }

        // Print the linked list
        Node temp = head;
        while (temp != null) {
            System.out.print(temp.data + " -> ");
            temp = temp.next;
        }
        System.out.println("null");
    }
}
